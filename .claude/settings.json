            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .cosmos/cosmosw hook",
            "timeout": 10
          }
        ]
      }
